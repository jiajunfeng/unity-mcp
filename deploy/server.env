export HOME=/usr/local/ifgame/iaf/server/UnityMCP/runtime

export OPENSSL_HOME=/data/ifgame/server/shared-runtime/openssl-1.1.1w
export PY310_HOME=/data/ifgame/server/shared-runtime/python/python310_ssl11

export LD_LIBRARY_PATH=$OPENSSL_HOME/lib:${LD_LIBRARY_PATH:-}
export PATH=$PY310_HOME/bin:${PATH:-}

export UNITY_MCP_TRANSPORT=http
export UNITY_MCP_HTTP_HOST=0.0.0.0
export UNITY_MCP_HTTP_PORT=10301

export UNITY_MCP_HTTP_REMOTE_HOSTED=true
export UNITY_MCP_API_KEY_VALIDATION_URL=http://127.0.0.1:10302/api/validate-key
export UNITY_MCP_API_KEY_LOGIN_URL=http://127.0.0.1:10302/api-keys
export UNITY_MCP_API_KEY_CACHE_TTL=300

export UNITY_MCP_PROJECT_SCOPED_TOOLS=true
export UNITY_MCP_SKIP_STARTUP_CONNECT=1
export DISABLE_TELEMETRY=1
